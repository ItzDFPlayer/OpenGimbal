    <string name="control_subtitle">Richte den Gimbal von Hand aus, ohne den physischen Drehknopf</string>
    <string name="stick_title">Steuerknüppel</string>
    <string name="stick_connect_prompt">Verbinde einen Gimbal, um ihn zu steuern.</string>
    <string name="stick_help_aim">Halten zum Bewegen, loslassen zum Stoppen, weiter ausschlagen für mehr Tempo. Die Ausrichtung unten ist der angeforderte Winkel des Gimbals, in Grad.</string>
    <string name="stick_help_steer">Halten zum Bewegen, loslassen zum Stoppen, weiter ausschlagen für mehr Tempo.</string>
    <string name="label_aim">Ausrichtung</string>
    <string name="value_aim">Gier %1$d°, Neigung %2$d°</string>
    <string name="stick_sweep_speed">Schwenkgeschwindigkeit, %1$s° pro Sekunde bei vollem Ausschlag</string>
    <string name="action_back_to_level">Zurück in die Waagerechte</string>
    <string name="command_title">Befehl</string>
    <string name="command_description">Das Protokoll bietet zwei Wege, den Gimbal zur Bewegung aufzufordern. Dieser sendet eine Geschwindigkeit, solange der Steuerknüppel gehalten wird, genau wie die Verfolgungsschleife der offiziellen App.</string>
    <string name="stick_mode_aim">In einem Winkel ausrichten</string>
    <string name="stick_mode_aim_description">Sendet die Gradzahl, auf die gerichtet werden soll. Der Gimbal fährt dorthin und hält sie.</string>
    <string name="stick_mode_steer">Steuern (Verfolgungsstil)</string>
    <string name="stick_mode_steer_description">Sendet eine Geschwindigkeit, solange der Steuerknüppel gehalten wird.</string>
    <string name="direction_title">Richtung</string>
    <string name="direction_description">In welche Richtung sich der Gimbal bei einem gegebenen Wert dreht, lässt sich nur durch Ausprobieren herausfinden, denn die offizielle App nutzt diese Befehle ausschließlich, um einem verfolgten Motiv zu folgen. Wenn eine Achse verkehrt läuft, kehre sie hier um.</string>
    <string name="direction_invert_x">Links / rechts umkehren</string>
    <string name="direction_invert_y">Oben / unten umkehren</string>
    <string name="direction_app_driven">App-gesteuertes Flag senden</string>
    <string name="direction_app_driven_description">Wird nur vom Steuerbefehl verwendet. Die offizielle App setzt es, wenn das Telefon die Ausrichtung übernimmt.</string>

    <!-- Object tracking -->
    <string name="tracking_title">Objektverfolgung</string>
    <string name="tracking_description">Verfolgt etwas, das du auf dem Bildschirm antippst. Schalte dies ein, öffne eine Kamera-App, drücke dann die schwebende Taste und tippe das Objekt an, das du in der Bildmitte behalten willst.</string>
    <string name="tracking_trigger_note">Zweimaliges Drücken des Gimbal-Triggers stoppt es, denn dabei richtet sich der Gimbal selbst waagerecht aus.</string>
    <string name="tracking_battery_note">Verfolgung ist teuer: Der Bildschirm wird kopiert und jedes Bild nach deinem Objekt durchsucht, rechne also mit deutlich kürzerer Akkulaufzeit, solange sie läuft.</string>
    <string name="tracking_button_label">Schwebende Taste</string>
    <string name="tracking_needs_service">Benötigt die Bedienungshilfe, die derzeit ausgeschaltet ist.</string>
    <string name="tracking_button_hint">Schalte dies ein und öffne dann eine Kamera-App - die Taste erscheint nur über einer.</string>
    <string name="tracking_button_live">Die Taste ist auf dem Bildschirm, während eine Kamera-App läuft.</string>
    <string name="tracking_phase_off">Aus</string>
    <string name="tracking_phase_idle">Bereit, wartet auf die Taste</string>
    <string name="tracking_phase_waiting_for_camera">Wartet auf eine Kamera-App - die Taste erscheint über einer</string>
    <string name="tracking_phase_connecting">Wartet auf die Bildschirmaufnahme-Berechtigung</string>
    <string name="tracking_phase_selecting">Tippe ein Objekt an, um es zu verfolgen</string>
    <string name="tracking_phase_tracking">Verfolgt</string>
    <string name="tracking_phase_lost">Objekt verloren, der Gimbal hält still</string>
    <string name="tracking_label_screen_read">Bildschirmauslese</string>
    <string name="tracking_value_fps">%1$s Bilder pro Sekunde</string>
    <string name="tracking_label_match">Übereinstimmung</string>
    <string name="tracking_value_percent">%1$d%%</string>
    <string name="tracking_label_object_at">Objekt bei</string>
    <string name="tracking_label_correcting">Korrektur</string>
    <string name="tracking_value_correction">%1$s° Gier, %2$s° Neigung</string>
    <string name="tracking_label_measured">Gemessen</string>
    <string name="tracking_label_scale">Größe</string>
    <string name="tracking_value_scale">%1$s×</string>
    <string name="tracking_value_px_per_degree">%1$s px pro Grad</string>
    <string name="tracking_readout_help">Während der Verfolgung solltest du diese Zahlen beobachten. Das Objekt sollte zur Mitte gezogen werden, die Korrektur sollte kleiner werden, und die gemessenen Pixel pro Grad sollten sich einpendeln statt auf dem Startwert zu bleiben. Wird das Objekt stattdessen weiter nach außen gedrückt, kehre die passende Richtung unten um.</string>
    <string name="tracking_reversed_warning">Etwas läuft verkehrt: %1$d Korrekturen gingen entgegen der Richtung, in die sie hätten gehen sollen. Kehre die passende Richtung unten um.</string>
    <string name="tracking_strength">Korrekturstärke, %1$d%%</string>
    <string name="tracking_strength_help">Wie viel der Strecke zur Mitte der Gimbal in einem Schritt zurückzulegen versucht. Die Standardeinstellung lässt ihn die Hälfte korrigieren, was Spielraum dafür lässt, dass die eigene Vorstellung des Gimbals, wie weit ein Grad das Bild verschiebt, falsch ist - das wird während der Verfolgung gemessen und oben angezeigt. Ein höherer Wert greift stärker ein und riskiert Überschwingen.</string>

