    <string name="tracking_title">Tárgykövetés</string>
    <string name="tracking_description">A képernyőn megérintett dolgot követi. Bekapcsolás után egy kameraalkalmazást kell megnyitni, majd a lebegő gombot megnyomni, és megérinteni a követni kívánt tárgyat.</string>
