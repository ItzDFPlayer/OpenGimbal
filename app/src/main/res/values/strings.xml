    <!-- Object tracking -->
    <string name="tracking_title">Object tracking</string>
    <string name="tracking_description">Follows something you tap on the screen. Switch this on, open a camera app, then press the floating button and tap the object you want to keep in the middle of the frame.</string>
    <string name="tracking_trigger_note">Pressing the gimbal\'s trigger twice stops it, because the gimbal levels itself when you do that.</string>
    <string name="tracking_battery_note">Tracking is expensive: the screen is copied and every frame searched for your object, so expect noticeably shorter battery life while it is on.</string>
    <string name="tracking_button_label">Floating button</string>
    <string name="tracking_needs_service">Needs the accessibility service, which is currently switched off.</string>
    <string name="tracking_button_hint">Switch this on, then open a camera app - the button only appears over one.</string>
    <string name="tracking_button_live">The button is on screen while a camera app is running.</string>
    <string name="tracking_phase_off">Off</string>
    <string name="tracking_phase_idle">Ready, waiting for the button</string>
    <string name="tracking_phase_waiting_for_camera">Waiting for a camera app - the button appears over one</string>
    <string name="tracking_phase_connecting">Waiting for screen capture permission</string>
    <string name="tracking_phase_selecting">Press on an object to track</string>
    <string name="tracking_phase_tracking">Following</string>
    <string name="tracking_phase_lost">Object lost, the gimbal is holding still</string>
    <string name="tracking_label_screen_read">Screen read</string>
    <string name="tracking_value_fps">%1$s frames a second</string>
    <string name="tracking_label_match">Match</string>
    <string name="tracking_value_percent">%1$d%%</string>
    <string name="tracking_label_object_at">Object at</string>
    <string name="tracking_label_correcting">Correcting</string>
    <string name="tracking_value_correction">%1$s° yaw, %2$s° pitch</string>
    <string name="tracking_label_measured">Measured</string>
    <string name="tracking_label_scale">Size</string>
    <string name="tracking_value_scale">%1$s×</string>
    <string name="tracking_value_px_per_degree">%1$s px per degree</string>
    <string name="tracking_readout_help">While it is following, watch those numbers. The object should be pulled towards the middle, the correction should shrink, and the measured pixels per degree should settle instead of the value it started at. If the object is pushed further out instead, flip the matching direction below.</string>
    <string name="tracking_reversed_warning">Something is moving the wrong way: %1$d corrections went opposite to the direction they should have. Flip the matching direction below.</string>
    <string name="tracking_strength">Correction strength, %1$d%%</string>
    <string name="tracking_strength_help">How much of the distance to the middle the gimbal tries to cover in one step. The default leaves it correcting half of it, which has room for the gimbal\'s own idea of how far one degree moves the picture being wrong - that is measured while following, and shown above. Raising this chases harder and risks overshooting.</string>

