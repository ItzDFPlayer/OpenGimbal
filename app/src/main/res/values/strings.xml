    <!-- Accessibility service configuration -->
    <string name="app_name" translatable="false">OpenGimbal</string>
    <string name="accessibility_service_label">OpenGimbal</string>
    <string name="accessibility_service_summary">Maps gimbal buttons and the zoom slider to pinch-zoom, volume and navigation actions, and can press a camera app\'s on-screen shutter.</string>
    <string name="accessibility_service_description">Turns gimbal button and slider events into system-wide input.\n\nUses gestures for pinch-zoom and navigation, and the audio system for volume. Only when you map a trigger to the on-screen shutter does it read the current screen - the view hierarchy, and if that finds nothing, a screenshot - purely to locate that button. If you switch on the video restart it also asks the audio system whether the microphone is in use, to tell a video recording from a photo; it never records or listens to anything. Nothing is stored or sent anywhere.</string>

