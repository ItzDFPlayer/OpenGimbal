    <!-- Object tracking -->
    <string name="tracking_title">Śledzenie obiektu</string>
    <string name="tracking_description">Śledzi to, co dotkniesz na ekranie. Włącz to, otwórz aplikację aparatu, a potem naciśnij przycisk pływający i dotknij obiektu, który ma zostać na środku kadru.</string>
    <string name="tracking_trigger_note">Dwukrotne naciśnięcie spustu gimbala zatrzymuje śledzenie, bo gimbal sam się wtedy poziomuje.</string>
    <string name="tracking_battery_note">Śledzenie jest kosztowne: ekran jest kopiowany, a w każdej klatce szukany jest twój obiekt, więc przy włączonym śledzeniu bateria wytrzyma zauważalnie krócej.</string>
    <string name="tracking_button_label">Przycisk pływający</string>
    <string name="tracking_needs_service">Wymaga usługi ułatwień dostępu, która jest teraz wyłączona.</string>
    <string name="tracking_button_hint">Włącz to, a potem otwórz aplikację aparatu — przycisk pojawia się tylko nad nią.</string>
    <string name="tracking_button_live">Przycisk jest na ekranie, gdy działa aplikacja aparatu.</string>
    <string name="tracking_phase_off">Wyłączone</string>
    <string name="tracking_phase_idle">Gotowe, czekam na przycisk</string>
    <string name="tracking_phase_waiting_for_camera">Czekam na aplikację aparatu — przycisk pojawia się nad nią</string>
    <string name="tracking_phase_connecting">Czekam na zgodę na przechwytywanie ekranu</string>
    <string name="tracking_phase_selecting">Naciśnij obiekt, aby go śledzić</string>
    <string name="tracking_phase_tracking">Śledzenie</string>
    <string name="tracking_phase_lost">Obiekt zgubiony, gimbal stoi nieruchomo</string>
    <string name="tracking_label_screen_read">Odczyt ekranu</string>
    <string name="tracking_value_fps">Klatki na sekundę: %1$s</string>
    <string name="tracking_label_match">Dopasowanie</string>
    <string name="tracking_value_percent">%1$d%%</string>
    <string name="tracking_label_object_at">Obiekt na</string>
    <string name="tracking_label_correcting">Korekcja</string>
    <string name="tracking_value_correction">%1$s° obrót, %2$s° pochylenie</string>
    <string name="tracking_label_measured">Pomiar</string>
    <string name="tracking_label_scale">Rozmiar</string>
    <string name="tracking_value_scale">%1$s×</string>
    <string name="tracking_value_px_per_degree">%1$s px na stopień</string>
    <string name="tracking_readout_help">Gdy śledzenie działa, obserwuj te liczby. Obiekt powinien być ściągany do środka, korekcja powinna maleć, a zmierzone piksele na stopień powinny ustabilizować się na innej wartości niż początkowa. Jeśli obiekt jest wypychany na zewnątrz, odwróć odpowiedni kierunek poniżej.</string>
    <string name="tracking_reversed_warning">Coś idzie w złą stronę: korekcje w przeciwnym kierunku niż powinny — %1$d. Odwróć odpowiedni kierunek poniżej.</string>
    <string name="tracking_strength">Siła korekcji: %1$d%%</string>
    <string name="tracking_strength_help">Jaką część drogi do środka gimbal stara się pokonać w jednym kroku. Domyślna wartość zostawia korekcję połowy tej drogi, co daje zapas na to, że wyobrażenie gimbala o tym, jak daleko jeden stopień przesuwa obraz, jest błędne — jest ono mierzone podczas śledzenia i pokazywane powyżej. Zwiększenie tej wartości sprawia, że gimbal goni mocniej i może przestrzelić.</string>

